{
  "attribution": { "commit": "", "pr": "", "sessionUrl": false },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-attribution.sh",
            "timeout": 10,
            "statusMessage": "Checking for tooling attribution"
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request|add_issue_comment|add_comment_to_pending_review|add_reply_to_pull_request_comment|issue_write|create_or_update_file|create_branch|push_files)",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-attribution.sh",
            "timeout": 10,
            "statusMessage": "Checking for tooling attribution"
          }
        ]
      }
    ]
  }
}

{
  // Cloudflare Workers config. The account ID and API token are supplied by
  // GitHub environment settings to wrangler at deploy time, not to the Worker.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "status-page",
  "main": "./src/server.cloudflare.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Each Worker claims only its own hostname, as a Custom Domain on a zone
  // in this account: szolotov.com for production, szolotov.dev for staging.
  // The first deploy creates the DNS record and certificate; a CI deploy
  // replaces any record already at that name. A route turns workers.dev off.
  // Production: status.szolotov.com.
  "routes": [{ "pattern": "status.szolotov.com", "custom_domain": true }],
  "env": {
    "staging": {
      "name": "status-page-staging",
      "observability": { "enabled": true },
      "preview_urls": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      // `routes` is inherited, so staging sets its own: stage.status.szolotov.dev.
      "routes": [{ "pattern": "stage.status.szolotov.dev", "custom_domain": true }],
      "vars": { "ROBOTS": "noindex" }
    }
  }
}

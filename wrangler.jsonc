{
  // Cloudflare Workers config. The account ID and API token are supplied by
  // GitHub environment settings to wrangler at deploy time, not to the Worker.
  // One Worker serves everything: main deploys it to production, and dev
  // becomes a Worker Preview of it named "dev" (deploy.yml), never production
  // traffic.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "status-page",
  "main": "./src/server.cloudflare.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Governs the workers.dev preview URLs only, so they stay off. The preview
  // is served on the custom preview domain below, which has its own switch
  // (previews_enabled).
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "routes": [
    // Production claims its own hostname as a Custom Domain on a zone in this
    // account. The first deploy creates the DNS record and certificate; a CI
    // deploy replaces any record already at that name.
    { "pattern": "status.szolotov.com", "custom_domain": true },
    // Preview-only Custom Domain: no production traffic, but previews get
    // https://<preview-name>.stage.status.szolotov.com (Cloudflare adds the
    // wildcard itself). A deploy replaces the Worker's whole set of Custom
    // Domains, so this one must be listed here, or the next deploy on main
    // would detach it. It goes live with the first such deploy.
    {
      "pattern": "stage.status.szolotov.com",
      "custom_domain": true,
      "enabled": false,
      "previews_enabled": true
    }
  ],
  // What a Worker Preview (`wrangler preview`) runs with. Previews take
  // their bindings from this block, not from the top level.
  "previews": {
    // Keeps search engines off the dev preview (src/lib/robots.ts).
    "vars": { "ROBOTS": "noindex" },
    "version_metadata": { "binding": "CF_VERSION_METADATA" }
  }
}

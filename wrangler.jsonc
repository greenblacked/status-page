{
  // Cloudflare Workers config. The account ID and API token are supplied by
  // GitHub environment settings to wrangler at deploy time, not to the Worker.
  // One Worker serves everything: main deploys it to production, and dev
  // uploads a preview version of it (deploy.yml), never production traffic.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "status-page",
  "main": "./src/server.cloudflare.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Preview versions are only reachable with this on. It is independent of
  // workers_dev, which a route already turns off.
  "preview_urls": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Production claims its own hostname as a Custom Domain on a zone in this
  // account. The first deploy creates the DNS record and certificate; a CI
  // deploy replaces any record already at that name.
  "routes": [{ "pattern": "status.szolotov.com", "custom_domain": true }]
}

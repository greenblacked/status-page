{
  // Cloudflare Workers config. The account ID and API token are supplied by
  // GitHub environment settings to wrangler at deploy time, not to the Worker.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "status-bar",
  "main": "./src/server.cloudflare.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "env": {
    "staging": {
      "name": "status-bar-staging",
      "observability": { "enabled": true },
      "preview_urls": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": { "ROBOTS": "noindex" }
    }
  }
}

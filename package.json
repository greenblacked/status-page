{
  "name": "status-page",
  "version": "0.6.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:cf": "DEPLOY_TARGET=cloudflare vite build",
    "start": "node src/node/serve.ts",
    "preview": "vite preview --host 127.0.0.1",
    "preview:cf": "DEPLOY_TARGET=cloudflare vite preview --host 127.0.0.1",
    "deploy:dry-run": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config dist/server/wrangler.json",
    "typecheck": "tsc6 --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "source-health": "node --experimental-strip-types scripts/ci/source-health.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test && ./scripts/ci/hygiene.sh && ./scripts/ci/links.sh"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-start": "1.168.59",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "seroval": "1.6.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "1.62.4",
    "@cloudflare/workers-types": "5.20261002.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "4.10.2",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.146.0"
  }
}

{
  "name": "status-page",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:cf": "DEPLOY_TARGET=cloudflare vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:cf": "DEPLOY_TARGET=cloudflare vite preview --host 127.0.0.1",
    "deploy:dry-run": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "source-health": "node --experimental-strip-types scripts/ci/source-health.ts",
    "check": "npm run lint && npm run typecheck && npm test && ./scripts/ci/hygiene.sh && ./scripts/ci/links.sh"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vite-plugin": "1.60.2",
    "@cloudflare/workers-types": "5.20260927.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "seroval": "1.6.7",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.141.0"
  }
}
